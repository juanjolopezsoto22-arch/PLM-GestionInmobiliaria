    {
      "parameters": {
        "jsCode": "const TIMEZONE = 'America/Santiago';\nconst HORA_INICIO = 9;\nconst HORA_FIN = 18;\nconst DURACION_MIN = 60;\nconst DIAS_A_REVISAR = 10;\nconst SLOTS_NECESARIOS = 3;\n\nconst eventos = $input.all().map(i => i.json).filter(e => e && Object.keys(e).length > 0);\nfunction getStart(e){ return e.start?.dateTime || e.start || e.startDateTime; }\nfunction getEnd(e){ return e.end?.dateTime || e.end || e.endDateTime; }\n\nconst busy = eventos\n  .map(e => ({ start: new Date(getStart(e)), end: new Date(getEnd(e)) }))\n  .filter(e => !isNaN(e.start) && !isNaN(e.end));\n\nfunction overlaps(aS, aE, bS, bE) { return aS < bE && aE > bS; }\n\n// Offset real de Chile para una fecha dada (ajusta solo cuando hay cambio de horario)\nfunction offsetMinutos(date) {\n  const dtf = new Intl.DateTimeFormat('en-US', {\n    timeZone: TIMEZONE, hourCycle: 'h23',\n    year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: '2-digit', minute: '2-digit', second: '2-digit'\n  });\n  const p = dtf.formatToParts(date).reduce((a, x) => (a[x.type] = x.value, a), {});\n  const comoUTC = Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second);\n  return (comoUTC - date.getTime()) / 60000;\n}\n\nfunction formatChile(date) {\n  return date.toLocaleString('es-CL', {\n    weekday: 'long', day: '2-digit', month: 'long',\n    hour: '2-digit', minute: '2-digit', timeZone: TIMEZONE\n  });\n}\n\nconst now = new Date();\nconst slots = [];\n\nfor (let d = 0; d < DIAS_A_REVISAR && slots.length < SLOTS_NECESARIOS; d++) {\n  const cursor = new Date(now.getTime() + d * 86400000);\n  const fechaSantiago = cursor.toLocaleDateString('en-CA', { timeZone: TIMEZONE });\n  const weekday = cursor.toLocaleDateString('es-CL', { weekday: 'short', timeZone: TIMEZONE }).toLowerCase();\n  if (weekday.startsWith('sá') || weekday.startsWith('do')) continue;\n\n  for (let hora = HORA_INICIO; hora < HORA_FIN && slots.length < SLOTS_NECESARIOS; hora++) {\n    const tentativoUTC = new Date(`${fechaSantiago}T${String(hora).padStart(2, '0')}:00:00Z`);\n    const offset = offsetMinutos(tentativoUTC);\n    const slotStart = new Date(tentativoUTC.getTime() - offset * 60000);\n    const slotEnd = new Date(slotStart.getTime() + DURACION_MIN * 60000);\n\n    if (slotStart <= now) continue;\n    const ocupado = busy.some(b => overlaps(slotStart, slotEnd, b.start, b.end));\n    if (!ocupado) slots.push({ iso: slotStart.toISOString(), texto: formatChile(slotStart) });\n  }\n}\n\nreturn [{\n  json: {\n    opcion_1: slots[0]?.iso || \"\",\n    opcion_2: slots[1]?.iso || \"\",\n    opcion_3: slots[2]?.iso || \"\",\n    horarios_disponibles: slots,\n    horarios_texto: slots.map((s, i) => `${i + 1}. ${s.texto}`).join('\\n')\n  }\n}];"
      },
