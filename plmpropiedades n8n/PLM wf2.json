    {
      "parameters": {
        "jsCode": "const data = $input.all()[0]?.json;\nif (!data) throw new Error('No se recibieron datos del AI Agent.');\n\nconst opcionElegida = data.output?.opcion_elegida ?? data.opcion_elegida;\nif (![1, 2, 3].includes(opcionElegida)) {\n  return [{ json: { ...data, agenda: false } }];\n}\n\nconst isoElegido = $('Get row(s) in sheet').item.json['opcion_' + opcionElegida];\nif (!isoElegido) {\n  throw new Error('opcion_' + opcionElegida + ' no tiene un valor guardado en la Sheet.');\n}\n\nconst start = new Date(isoElegido);\nif (isNaN(start.getTime())) {\n  throw new Error('ISO invalido en opcion_' + opcionElegida + ': ' + isoElegido);\n}\n\nconst duracionMin = 60;\nconst end = new Date(start.getTime() + duracionMin * 60000);\n\nreturn [{ json: { ...data, agenda: true, start: start.toISOString(), end: end.toISOString() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
