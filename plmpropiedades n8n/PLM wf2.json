      ],
      "id": "e76eb3c2-1cc3-4c41-9ebd-eefdf2996bd2",
      "name": "Preparar Fecha Reunión"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"opcion_elegida\": {\n      \"type\": [\"integer\", \"null\"],\n      \"enum\": [1, 2, 3, null],\n      \"description\": \"Número de la opción elegida por el cliente (1, 2 o 3), o null si no eligió ninguna con claridad.\"\n    },\n    \"comentario\": {\n      \"type\": \"string\",\n      \"description\": \"Breve explicación de la elección o de por qué no se pudo determinar.\"\n    }\n  },\n  \"required\": [\"opcion_elegida\", \"comentario\"]\n}"
      },
      "id": "94827974-f971-4b78-a56f-b0c6c2174406",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        528,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const fecha = new Date($('Preparar Fecha Reunión').item.json.start);\n\nconst fechaTexto = fecha.toLocaleString('es-CL', {\n  weekday: 'long', day: '2-digit', month: 'long',\n  hour: '2-digit', minute: '2-digit', timeZone: 'America/Santiago'\n});\n\nconst nombre = $('Get row(s) in sheet').item.json.Nombre || '';\nconst saludo = nombre ? `Hola ${nombre}` : 'Hola';\n\nconst operacion = ($('Get row(s) in sheet').item.json.Operacion || 'tu solicitud').toLowerCase();\nconst comuna = $('Get row(s) in sheet').item.json.Comuna || '';\nconst comunaTexto = comuna ? ` en ${comuna}` : '';\n\nconst cuerpo = `${saludo},<br><br>` +\n  `¡Buenas noticias! Confirmamos tu reunión para el <strong>${fechaTexto}</strong><br><br>` +\n  `Quedamos coordinados para conversar sobre tu operación de ${operacion}${comunaTexto}. Si necesitas reprogramar o tienes alguna consulta antes de la reunión, escríbenos y con gusto te ayudamos.<br><br>` +\n  `¡Nos vemos pronto!<br><br>` +\n  `Saludos cordiales,<br>Equipo PLM Propiedades`;\n\nreturn [{\n  json: {\n    email: $('Get row(s) in sheet').item.json.Email,\n    cuerpo_confirmacion: cuerpo,\n    fecha_texto: fechaTexto\n  }\n}];"
      },
